    {
      "type": "timeseries",
      "title": "API Request Latency (1m window)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(chest_xray_request_latency_seconds_sum[1m])) / sum(rate(chest_xray_request_latency_seconds_count[1m]))",
          "legendFormat": "Average Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(chest_xray_request_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "ML Pipeline Step Latencies (p95)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(chest_xray_preprocessing_seconds_bucket[1m])) by (le))",
          "legendFormat": "Preprocessing",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(chest_xray_model_inference_seconds_bucket[1m])) by (le))",
          "legendFormat": "Model Inference",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(chest_xray_postprocessing_seconds_bucket[1m])) by (le))",
          "legendFormat": "Postprocessing",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ],
